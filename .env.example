# Backend NestJS API (default port 3000)
# Browser / client-side requests (also baked into the Docker image at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-side requests from Next.js route handlers (Docker only).
# Points at the API on the host machine; not needed for local `npm run dev`.
# API_URL=http://host.docker.internal:3000
